Synthetic example deck - a single 5 m x 3 m room with a 500 kW propane burner.
Invented geometry for documentation and tests; it is not a real building or project.
Expected result of bulc_check_deck: no errors, no warnings.

&HEAD CHID='room_fire_synthetic', TITLE='Synthetic example - single room fire' /
&TIME T_END=300.0 /
&MISC TMPA=20.0 /

&MESH ID='M1', IJK=60,40,30, XB=-0.5,5.5,-0.5,3.5,0.0,3.0 /

&REAC FUEL='PROPANE', SOOT_YIELD=0.024, CO_YIELD=0.005 /

&MATL ID='GYPSUM', CONDUCTIVITY=0.48, SPECIFIC_HEAT=0.84, DENSITY=1440.0 /
&SURF ID='WALL_GYPSUM', MATL_ID='GYPSUM', THICKNESS=0.0125, COLOR='BEIGE' /
&SURF ID='BURNER', HRRPUA=500.0, RAMP_Q='FIRE_RAMP', COLOR='RED' /
&RAMP ID='FIRE_RAMP', T=0.0, F=0.0 /
&RAMP ID='FIRE_RAMP', T=120.0, F=1.0 /
&RAMP ID='FIRE_RAMP', T=300.0, F=1.0 /

&OBST ID='W_S', XB=0.0,5.0,0.0,0.1,0.0,2.8, SURF_ID='WALL_GYPSUM' /
&OBST ID='W_N', XB=0.0,5.0,2.9,3.0,0.0,2.8, SURF_ID='WALL_GYPSUM' /
&OBST ID='W_W', XB=0.0,0.1,0.0,3.0,0.0,2.8, SURF_ID='WALL_GYPSUM' /
&OBST ID='W_E', XB=4.9,5.0,0.0,3.0,0.0,2.8, SURF_ID='WALL_GYPSUM' /
&OBST ID='CEILING', XB=0.0,5.0,0.0,3.0,2.8,2.9, SURF_ID='WALL_GYPSUM' /
&HOLE ID='Door_EXIT_1', XB=4.85,5.05,1.0,2.0,0.0,2.0 /

&OBST ID='FIRE_BASE', XB=2.0,3.0,1.0,2.0,0.0,0.4, SURF_IDS='BURNER','INERT','INERT' /

&VENT ID='OPEN_XMAX', MB='XMAX', SURF_ID='OPEN' /

&PROP ID='HD_68', ACTIVATION_TEMPERATURE=68.0, RTI=50.0 /
&DEVC ID='HD_1', XYZ=2.5,1.5,2.75, PROP_ID='HD_68', QUANTITY='LINK TEMPERATURE' /
&DEVC ID='T_DOOR', XYZ=4.5,1.5,1.8, QUANTITY='TEMPERATURE' /
&DEVC ID='VIS_DOOR', XYZ=4.5,1.5,1.8, QUANTITY='VISIBILITY' /

&SLCF ID='T_Y15', PBY=1.5, QUANTITY='TEMPERATURE' /
&SLCF ID='VIS_Z18', PBZ=1.8, QUANTITY='VISIBILITY' /

&DUMP DT_SLCF=1.0, DT_DEVC=1.0, DT_HRR=1.0, DT_PL3D=10.0,
      PLOT3D_QUANTITY='TEMPERATURE','VISIBILITY','VOLUME FRACTION','VOLUME FRACTION','VOLUME FRACTION',
      PLOT3D_SPEC_ID(3:5)='CARBON MONOXIDE','CARBON DIOXIDE','OXYGEN' /

&TAIL /
