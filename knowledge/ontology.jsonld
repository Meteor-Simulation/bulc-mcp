      "unit": "m",
      "defaultValue": 5
    },
    {
      "@id": "bulc:AsetCriteria.coMaxPpm",
      "@type": "rdf:Property",
      "label": {
        "en": "coMaxPpm"
      },
      "domainIncludes": "bulc:AsetCriteria",
      "valueType": "number",
      "unit": "ppm",
