      "label": {
        "en": "o2Min"
      },
      "domainIncludes": "bulc:AsetCriteria",
      "valueType": "number",
      "unit": "%",
      "defaultValue": 15
    },
    {
      "@id": "bulc:AsetCriteria.co2Max",
