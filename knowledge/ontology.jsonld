  "@graph": [
    {
      "@id": "bulc:",
      "@type": "schema:DefinedTermSet",
      "label": {
        "en": "BULC fire / evacuation / HVAC / sprinkler domain ontology"
      },
      "schema:dateModified": "2026-10-02",
      "bulc:fdsVersion": "6.10.1",
      "bulc:conventions": "{\"units\": {\"length\": \"m (도면 DXF/DWG 는 보통 mm — 1 mm = 0.001 m)\", \"duct_and_pipe_size\": \"mm (덕트 지름·폭·높이, 배관 호칭경)\", \"time\": \"s\", \"temperature\": \"°C (FDS 덱의 TMPA, TMP_FRONT, ACTIVATION_TEMPERATURE 모두 섭씨). 엔진 실행 지표 Tmax 는 K.\", \"heat_release_rate\": \"kW (HRR), kW/m² (HRRPUA = 단위 면적당 발열량)\", \"heat_flux\": \"kW/m²\", \"mass_flux\": \"kg/(m²·s)\", \"volume_flow_fds\": \"m³/s (FDS VOLUME_FLOW)\", \"volume_flow_hvac_module\": \"CFM (BULC HVAC 모듈 입력). 1 CFM = 0.000471947 m³/s, 1 m³/h = 0.5886 CFM, 1 m³/min = 35.31 CFM\", \"water_flow\": \"L/min\", \"pressure_pipe_network\": \"MPa (배관망 수력계산·요구 방사압·펌프). 0.1 MPa = 1 bar ≈ 10.2 m 수두\", \"pressure_fds_sprinkler\": \"bar (FDS &PROP OPERATING_PRESSURE, add_sprinkler 의 operating_pressure)\", \"pressure_hvac\": \"Pa\", \"k_factor\": \"L/(min·bar^½) (미터계). 미국 gpm/psi^½ 값 × 14.41. Q = K·√P (P 는 bar)\", \"rti\": \"(m·s)^½\", \"droplet_diameter\": \"µm\", \"yields\": \"kg/kg (연료 질량당 생성 질량)\", \"concentrations_aset\": \"CO ppm, O₂·CO₂ 부피 %, 가시거리 m\"}, \"coordinates\": {\"axes\": \"x, y = 평면(도면) 좌표, z = 연직(위가 +). FDS 와 BULC 모두 z-up 입니다.\", \"origin\": \"프로젝트 원점은 사용자가 정합니다. 도면을 옮길 때는 한 기준점(예: 도면 좌하단 기둥 중심)을 (0,0) 으로 정하고 기록합니다.\", \"image_y_flip\": \"이미지(PNG/JPG/PDF 렌더) 픽셀 좌표는 y 가 아래로 증가합니다. 모델 y = (이미지 높이 − 픽셀 y) × 축척.\", \"xb\": \"XB = [x1, x2, y1, y2, z1, z2] (각 축 min, max 쌍). [x1, y1, z1, x2, y2, z2] 순서가 아닙니다.\", \"point\": \"XYZ = [x, y, z]\", \"plane\": \"평면(VENT, 화원 면, 경계면)은 한 축의 min = max 입니다. 예: 바닥 화원 XB=[4,5,4,5,0,0]\", \"faces\": \"면 순서(SURF_ID6) = [-X, +X, -Y, +Y, -Z, +Z]\", \"story_elevation\": \"층 높이 zMin 은 draw_list_stories 로 확인합니다. 기본값: 1F zMin=0, 층고 3.0 m, 층간 슬래브 0.2 m → 2F zMin=3.2 m\"}, \"floor_identifiers\": {\"story_id\": \"draw 층 id (1부터). draw_update_story / draw_remove_story / spr_* 도구의 floorIndex·targetFloorIndex 가 이 id 를 받습니다.\", \"evac_floor_index\": \"피난(EVAC)·HVAC 도구의 floorIndex 는 층을 높이순으로 정렬한 0부터의 순번입니다(1F → 0, 2F → 1).\", \"warning\": \"같은 이름(floorIndex)이 도구마다 다른 뜻입니다 — rules.yaml EVAC-001 참조.\"}, \"ids\": {\"uniqueness\": \"같은 namelist 그룹 안에서 ID 는 유일해야 합니다(OBST, HOLE, VENT, DEVC, CTRL, SLCF, SURF, MATL …).\", \"generated_ids\": \"배관망(spr_*)·HVAC(hvac_*)·피난(evac_*) 노드 id 는 스토어가 만듭니다. 만든 직후 spr_list_summary / hvac_list_summary / evac_list_summary 로 id 를 읽어 다음 호출에 씁니다.\", \"chid\": \"프로젝트를 저장하면 CHID 가 저장 파일 이름으로 바뀝니다(GEN-009).\"}, \"modes\": {\"snapshot\": \"BULC 앱이 실행 중이 아님 — 서버가 내장 도구 목록(스냅샷)만 보여 줍니다. 지식 도구(bulc_knowledge_search, bulc_get_rules, bulc_plan_check, bulc_drawing_intake, bulc_check_deck, bulc_mesh_advisor)는 동작하지만 앱 도구 호출은 '앱을 실행하세요' 오류로 끝납니다. 이 상태에서 편집·실행이 됐다고 말하지 않습니다(GEN-018).\", \"live\": \"실행 중인 BULC 데스크톱 앱에 연결 — 편집이 화면에 바로 반영되고 프로젝트 열기·저장(project_*), 실행(sim_preflight → sim_start → sim_status), 결과 읽기(fire_*, evac_get_results), 화면 캡처(capture_view), result_* 가 동작합니다. 연결 여부·도구 집합은 bulc_connection_status 로 확인합니다. 서버는 앱의 발견 파일(BULC/bridge.json)로 주소·토큰을 찾습니다.\"}, \"app_versions\": {\"note\": \"도구 집합은 앱 버전마다 다릅니다. 실제 기준은 연결된 앱의 tools/list 입니다.\", \"0.89+\": \"project_info/open/save/new/export_fds/undo/redo, get_conventions, fds_apply_text, sim_preflight/start/status/stop/log_tail, results_detect, fire_results_summary/timeseries/compute_aset, output_add_tenability_slices, capture_view, evac_run/status/stop/get_results, arch_analyze_drawing/import_building/import_floorplan_report\", \"0.88 이하\": \"위 도구가 없습니다 — 열기·저장은 앱 파일 메뉴, 실행은 run_simulation(이 서버의 가드), 피난 실행·결과는 앱 EVAC 탭, 건축 평면은 bulc_drawing_intake 의 벽 후보 + add_wall 로 합니다.\"}, \"app_only_actions\": {\"file_menu\": \"BULC 0.89 이상은 project_open / project_save / project_export_fds / project_new 로 앱의 현재 프로젝트를 열고 저장합니다(저장 안 된 변경·덮어쓰기는 사용자 확인 뒤). 그 이전 앱은 사용자가 앱의 파일 메뉴에서 합니다. new_project / open_project / save_project / export_fds 는 다른 서버의 이름입니다(GEN-014).\", \"evacuation_run\": \"피난 실행은 evac_run → evac_status → evac_get_results(0.89+). FED 연계·경보 연동 설정은 앱 EVAC 탭에서 사용자가 켭니다 — 켠 설정은 evac_run 입력에 들어갑니다(EVAC-004).\", \"architectural_drawing\": \"건축 평면 인식은 arch_analyze_drawing → arch_import_building(0.89+), 그림은 arch_import_floorplan_report. 앱 2D 편집기의 CAD 배경 기능은 사용자가 화면에서 쓰는 다른 경로입니다(DRW-004).\"}}"
    },
    {
      "@id": "bulc:Project",
      "@type": "rdfs:Class",
      "label": {
        "en": "Project",
        "ko": "프로젝트"
      },
      "comment": "하나의 해석 단위. .bulc 번들(.fds 텍스트 + 피난·배관망·HVAC 상태 JSON)로 저장합니다.",
      "area": "core",
      "fdsNamelist": [
        "&HEAD CHID, TITLE"
      ],
      "readBy": [
        "tool:project_info",
        "tool:get_project_summary",
        "tool:get_config_summary",
        "tool:get_simulation_settings",
        "tool:preview_fds",
        "tool:get_conventions"
      ],
      "otherTool": [
        "tool:project_open",
        "tool:project_save",
        "tool:project_new",
        "tool:project_export_fds",
        "tool:sim_start",
        "tool:run_simulation",
        "tool:capture_view"
      ],
      "updatedBy": [
        "tool:set_chid",
        "tool:fds_apply_text",
        "tool:project_undo",
        "tool:project_redo"
      ],
      "checkedBy": [
        "tool:validate_project",
        "tool:sim_preflight",
        "tool:bulc_check_deck"
      ],
      "seeRule": [
        "rule:GEN-006",
        "rule:GEN-009",
        "rule:GEN-010",
        "rule:GEN-014",
        "rule:GEN-016",
        "rule:GEN-017"
      ]
    },
    {
      "@id": "bulc:Project.chid",
      "@type": "rdf:Property",
      "label": {
        "en": "chid"
      },
      "domainIncludes": "bulc:Project",
      "valueType": "string",
      "note": "출력 파일 이름 접두어. 마침표·공백 불가. 저장 시 파일 이름으로 정규화"
    },
    {
      "@id": "bulc:Project.title",
      "@type": "rdf:Property",
      "label": {
        "en": "title"
      },
      "domainIncludes": "bulc:Project",
      "valueType": "string"
    },
    {
      "@id": "bulc:Project.file_path",
      "@type": "rdf:Property",
      "label": {
        "en": "file_path"
      },
      "domainIncludes": "bulc:Project",
      "valueType": "path",
      "note": ".bulc 또는 .fds 절대 경로"
    },
    {
      "@id": "bulc:Story",
      "@type": "rdfs:Class",
      "label": {
        "en": "Story",
        "ko": "층"
      },
      "comment": "건물 층. 2D 편집과 층 단위 표시·배관망 층 판정·피난 층 판정의 기준입니다. FDS 덱에는 층 개념이 없고 z 좌표만 있습니다.",
      "area": "core",
      "createdBy": [
        "tool:draw_add_story"
      ],
      "readBy": [
        "tool:draw_list_stories"
      ],
      "updatedBy": [
        "tool:draw_update_story",
        "tool:draw_set_wall_params",
        "tool:draw_set_door_params",
        "tool:draw_set_window_params"
      ],
      "deletedBy": [
        "tool:draw_remove_story"
      ],
      "seeRule": [
        "rule:GEO-002",
        "rule:GEO-007",
        "rule:EVAC-001"
      ]
    },
    {
      "@id": "bulc:Story.id",
      "@type": "rdf:Property",
      "label": {
        "en": "id"
      },
      "domainIncludes": "bulc:Story",
      "valueType": "integer",
      "note": "1부터. 1F = 1"
    },
    {
      "@id": "bulc:Story.name",
      "@type": "rdf:Property",
      "label": {
        "en": "name"
      },
      "domainIncludes": "bulc:Story",
      "valueType": "string",
      "note": "기본 '<id>F'"
    },
    {
      "@id": "bulc:Story.zMin",
      "@type": "rdf:Property",
      "label": {
        "en": "zMin"
      },
      "domainIncludes": "bulc:Story",
      "valueType": "number",
      "unit": "m",
      "note": "층 바닥 윗면 높이"
    },
    {
      "@id": "bulc:Story.height",
      "@type": "rdf:Property",
      "label": {
        "en": "height"
      },
      "domainIncludes": "bulc:Story",
      "valueType": "number",
      "unit": "m",
      "note": "층고(바닥 윗면 → 천장 아랫면). 기본 3.0"
    },
    {
      "@id": "bulc:Simulation",
      "@type": "rdfs:Class",
      "label": {
        "en": "Simulation settings",
        "ko": "해석 설정"
      },
      "comment": "시간·해석 모드·난류 모델·수치 안정·주변 대기·실행 엔진 선택.",
      "area": "core",
      "fdsNamelist": [
        "&TIME",
        "&MISC",
        "&RADI",
        "&PRES",
        "&COMB"
      ],
      "updatedBy": [
        "tool:set_time",
        "tool:set_simulation_mode",
        "tool:set_turbulence_model",
        "tool:set_numerics",
        "tool:set_ambient",
        "tool:set_run_options",
        "tool:add_raw_namelist",
        "tool:remove_raw_namelist"
      ],
      "readBy": [
        "tool:get_simulation_settings",
        "tool:get_numerics",
        "tool:list_raw_namelists"
      ],
      "checkedBy": [
        "tool:sim_preflight"
      ],
      "otherTool": [
        "tool:sim_start",
        "tool:sim_stop",
        "tool:run_simulation",
        "tool:sim_status",
        "tool:sim_log_tail",
        "tool:get_simulation_metrics"
      ],
      "seeRule": [
        "rule:SIM-001",
        "rule:SIM-002",
        "rule:SIM-003",
        "rule:SIM-007",
        "rule:SIM-009",
        "rule:FIRE-005",
        "rule:GEN-016"
      ]
    },
    {
      "@id": "bulc:Simulation.t_begin",
      "@type": "rdf:Property",
      "label": {
        "en": "t_begin"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number",
      "unit": "s",
      "defaultValue": 0
    },
    {
      "@id": "bulc:Simulation.t_end",
      "@type": "rdf:Property",
      "label": {
        "en": "t_end"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number",
      "unit": "s",
      "note": "기본 프로젝트 10 s — 실제 해석에서는 반드시 다시 지정"
    },
    {
      "@id": "bulc:Simulation.simulation_mode",
      "@type": "rdf:Property",
      "label": {
        "en": "simulation_mode"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "enum",
      "allowedValues": [
        "LES",
        "VLES",
        "SVLES",
        "DNS"
      ],
      "note": "BULC 는 LES 를 씁니다. FDS 6.10.1 의 미지정 기본값은 VLES"
    },
    {
      "@id": "bulc:Simulation.turbulence_model",
      "@type": "rdf:Property",
      "label": {
        "en": "turbulence_model"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "enum",
      "allowedValues": [
        "DEARDORFF",
        "VREMAN",
        "WALE",
        "CONSTANT_SMAGORINSKY"
      ]
    },
    {
      "@id": "bulc:Simulation.dt",
      "@type": "rdf:Property",
      "label": {
        "en": "dt"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number",
      "unit": "s"
    },
    {
      "@id": "bulc:Simulation.lock_time_step",
      "@type": "rdf:Property",
      "label": {
        "en": "lock_time_step"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "boolean",
      "note": "true 면 dt 필수"
    },
    {
      "@id": "bulc:Simulation.cfl_max",
      "@type": "rdf:Property",
      "label": {
        "en": "cfl_max"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number"
    },
    {
      "@id": "bulc:Simulation.tmpa",
      "@type": "rdf:Property",
      "label": {
        "en": "tmpa"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number",
      "unit": "°C",
      "defaultValue": 20
    },
    {
      "@id": "bulc:Simulation.humidity",
      "@type": "rdf:Property",
      "label": {
        "en": "humidity"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "number",
      "unit": "%",
      "defaultValue": 40
    },
    {
      "@id": "bulc:Simulation.solver_type",
      "@type": "rdf:Property",
      "label": {
        "en": "solver_type"
      },
      "domainIncludes": "bulc:Simulation",
      "valueType": "enum",
      "allowedValues": [
        "gpu",
        "gpu_cutcell",
        "cpu_openmp"
      ],
      "note": "gpu = 기본 GPU 엔진, gpu_cutcell = 컷셀 엔진(베타), cpu_openmp = FDS 6.10.1 CPU"
    },
    {
      "@id": "bulc:Ramp",
      "@type": "rdfs:Class",
      "label": {
        "en": "Ramp",
        "ko": "램프(시간 함수)"
      },
      "comment": "시간에 따른 비율 곡선. 화원 HRR 성장, 급배기 기동, 노즐 유량 등에 씁니다.",
      "area": "core",
      "fdsNamelist": [
        "&RAMP ID, T, F"
      ],
      "createdBy": [
        "tool:add_ramp",
        "tool:add_fire"
      ],
      "updatedBy": [
        "tool:update_ramp"
      ],
      "deletedBy": [
        "tool:remove_ramp"
      ],
      "seeRule": [
        "rule:FIRE-004",
        "rule:FIRE-008"
      ]
    },
    {
      "@id": "bulc:Ramp.id",
      "@type": "rdf:Property",
      "label": {
        "en": "id"
      },
      "domainIncludes": "bulc:Ramp",
      "valueType": "string"
    },
    {
      "@id": "bulc:Ramp.points",
      "@type": "rdf:Property",
      "label": {
        "en": "points"
      },
      "domainIncludes": "bulc:Ramp",
      "valueType": "array of [t, f]",
      "unit": "s, 0–1 비율"
    },
    {
      "@id": "bulc:Mesh",
      "@type": "rdfs:Class",
      "label": {
        "en": "Mesh",
        "ko": "계산 격자"
      },
      "comment": "계산 영역과 셀. 단일 메시 또는 정육면체 셀의 다중 메시. 메시 밖의 물체·화원·장치는 계산에서 빠집니다.",
      "area": "geometry",
      "fdsNamelist": [
        "&MESH IJK, XB"
      ],
      "createdBy": [
        "tool:set_mesh",
        "tool:set_mesh_cell_size",
        "tool:auto_fit_mesh",
        "tool:set_meshes",
        "tool:auto_multimesh",
        "tool:auto_cutcell_mesh"
      ],
      "readBy": [
        "tool:list_meshes",
        "tool:get_config_summary"
      ],
      "updatedBy": [
        "tool:slice_mesh",
        "tool:merge_meshes"
      ],
      "checkedBy": [
        "tool:validate_project",
        "tool:bulc_mesh_advisor",
        "tool:bulc_check_deck"
      ],
      "seeRule": [
        "rule:MESH-001",
        "rule:MESH-002",
        "rule:MESH-003",
        "rule:MESH-004",
        "rule:MESH-005",
        "rule:MESH-006",
