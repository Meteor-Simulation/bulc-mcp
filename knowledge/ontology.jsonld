    {
      "@id": "bulc:AsetCriteria",
      "@type": "rdfs:Class",
      "label": {
        "en": "ASET criteria",
        "ko": "인명안전 기준"
      },
      "comment": "국내 성능위주설계 기준(호흡한계선 1.8 m). 앱 기본값: 온도 60 °C, 가시거리 5 m, CO 1,400 ppm, O₂ 15 %, CO₂ 5 %.",
      "area": "results",
      "seeRule": [
        "rule:ASET-001",
        "rule:ASET-002",
        "rule:ASET-003"
      ]
    },
    {
      "@id": "bulc:AsetCriteria.samplingHeight",
